# ============================================================================
#  Copy this file to ".env" (same folder) and paste your real secrets below.
#  NEVER commit the real .env file.
# ============================================================================

# --- Google Gemini API key -------------------------------------------------
# Create one (free) at: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-api-key-here

# --- Email sending ---------------------------------------------------------
# Which service sends the report emails: "brevo" or "gmail"
EMAIL_PROVIDER=brevo

# The address emails are sent FROM
SENDER_EMAIL=rk26.ftw@gmail.com

# Option A - Brevo
# API key: https://app.brevo.com/settings/keys/api
# IMPORTANT: turn off IP blocking at https://app.brevo.com/security/authorised_ips
# and verify SENDER_EMAIL under Senders, Domains & Dedicated IPs -> Senders.
BREVO_API_KEY=paste-your-brevo-api-key-here

# Option B - Gmail (set EMAIL_PROVIDER=gmail)
# Needs 2-Step Verification, then create an App Password (16 characters):
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# --- Optional overrides ----------------------------------------------------
# SENDER_NAME=Video Insights
# GEMINI_MODEL=gemini-3.8-flash
