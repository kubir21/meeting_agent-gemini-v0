# ============================================================================
#  Copy this file to ".env" (same folder) and paste your real secrets below.
#  NEVER commit the real .env file.
# ============================================================================

# --- Google Gemini API key -------------------------------------------------
# Create one (free) at: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-api-key-here

# --- Brevo (email sending) -------------------------------------------------
# API key: Brevo dashboard -> top-right menu -> SMTP & API -> API Keys -> Generate
# (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=paste-your-brevo-api-key-here

# Sender address. It MUST be a verified sender in Brevo:
# Brevo dashboard -> Senders, Domains & Dedicated IPs -> Senders -> Add a sender
BREVO_SENDER_EMAIL=your.address@example.com

# --- Optional overrides ----------------------------------------------------
# BREVO_SENDER_NAME=Video Analysis Bot
# Gemini model used for analysis (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
